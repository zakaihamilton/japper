{
    "name": "japper",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome check . && eslint .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "health": "repnix check",
        "health:dead-code": "knip",
        "health:duplication": "jscpd app",
        "health:architecture": "depcruise --output-type json --config -- app",
        "health:licenses": "license-checker --json",
        "health:documentation": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#playwright-report\" \"#test-results\" \"#coverage\" \"#dist\" \"#build\" \"#.next\" \"#.turbo\" \"#.git\" \"#generated\" \"#AGENTS.md\" \"#CLAUDE.md\"",
        "health:a11y": "playwright test tests/e2e/guardrails.spec.ts --project=chromium --grep=WCAG",
        "health:visual": "if [ \"$RUN_VISUAL_REGRESSION\" = \"1\" ] || [ \"$(uname)\" = \"Darwin\" ]; then playwright test tests/e2e/guardrails.spec.ts --project=chromium; else echo \"Visual regression runs in the macOS guardrail job.\"; fi",
        "health:styles": "stylelint --formatter json \"**/*.{css,pcss,postcss}\""
    },
    "dependencies": {
        "lucide-react": "^0.556.0",
        "next": "^16.2.10",
        "react": "^19.2.1",
        "react-dom": "^19.2.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.2",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dependency-cruiser": "^18.2.0",
        "jscpd": "^5.0.14",
        "knip": "^6.32.2",
        "license-checker": "^25.0.1",
        "markdownlint-cli2": "^0.23.2",
        "repnix": "^1.1.0",
        "typescript": "^5",
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "stylelint": "^17.11.1",
        "stylelint-config-standard": "^40.0.0",
        "@typescript-eslint/parser": "^8.71.0"
    }
}
